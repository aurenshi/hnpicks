# ===== HNPicks 配置 =====
# 筛选标准：至少几个不同的人、在几个不同的月份推荐过
MIN_AUTHORS=3
MIN_MONTHS=3
# 追平历史数据后，每隔几小时增量更新一次
INTERVAL_HOURS=6
# 从哪天开始回溯（HN 最早的评论在 2007 年）
BACKFILL_FROM=2007-01-01
SITE_TITLE=HNPicks · HN 反复安利的视频与帖子

# 强烈建议：YouTube Data API key（免费）。有了它才有视频时长、播放量、上传时间，「长视频」和时长/上传时间筛选才能用。
# 申请：Google Cloud 控制台 → 启用 "YouTube Data API v3" → 凭据 → 创建 API 密钥
YOUTUBE_API_KEY=

# 可选：填了就用 DeepSeek 做分类、中文标题和一句话推荐理由；不填就用关键词规则分类
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 网站地址：默认 :80 表示用服务器 IP 访问。有域名后改成域名（如 picks.example.com），会自动上 HTTPS
SITE_ADDRESS=:80
